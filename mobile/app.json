{
  "expo": {
    "name": "CasaFusion",
    "scheme": "casafusion",
    "slug": "casafusion",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.casafusion.pos",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C07",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/casaFusion.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#0A0C07"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "CasaFusion necesita acceso a tus fotos para usarlas como avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D4432B",
          "defaultChannel": "comandas_nuevas",
          "sounds": [
            "./assets/sounds/comanda_nueva.wav",
            "./assets/sounds/comanda_editada.wav"
          ]
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35774888-b08f-4d9e-b3ac-ed22795413e7"
      }
    },
    "owner": "marcoec"
  }
}
